---
import '../styles/global.css';
import { locales, defaultLocale, localePath, type Locale } from '../i18n/locale-utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
}

const { locale, title, description, ogImage = '/images/profile.jpg' } = Astro.props;
const canonicalUrl = new URL(localePath(locale), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={new URL(localePath(loc), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale), Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
