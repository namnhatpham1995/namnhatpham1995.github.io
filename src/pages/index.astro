---
import AssistantDialog from '../components/assistant-dialog.astro';
import { uiLabels } from '../i18n/ui-labels';
import { getContent } from '../i18n/locale-utils';
const locale = 'en' as const;
const content = getContent(locale);
const labels = uiLabels[locale];

const projectByTitle = (title: string) => content.projects.entries.find(entry => entry.title.startsWith(title))!;
const projectNotes = (title: string) => {
  const entry = projectByTitle(title);
  return { title: entry.title, paragraphs: entry.description, tags: entry.tech, links: entry.links.map(link => [link.label, link.url]) };
};
const projects = {
  deployer: {
    title: 'Microservice Deployer',
    paragraphs: [content.experience.entries[0].bullets[0], 'This is professional work. Internal source code is not publicly available.'],
    tags: ['Bash', 'c8y-cli', 'Cumulocity', 'Deployment automation'], links: [],
  },
  fintrack: projectNotes('FinTrack'),
  assistant: projectNotes('Portfolio AI Assistant'),
  storyboard: projectNotes('Storyboard'),
  hootden: projectNotes('Hootden'),
  thesis: projectNotes('M.Sc. Thesis'),
};

