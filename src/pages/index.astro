---
import BaseLayout from '../layouts/base-layout.astro';
import PortfolioPage from '../components/portfolio-page.astro';
import { getContent } from '../i18n/locale-utils';

const locale = 'en' as const;
const content = getContent(locale);
---

<BaseLayout locale={locale} title={content.meta.title} description={content.meta.description}>
  <PortfolioPage locale={locale} content={content} />
</BaseLayout>
