---
// Sibling dialog opened by any element carrying `data-open-assistant` (see
// `network-intro.astro`'s "ask my assistant" button). Talks to the
// portfolio-voice-agent backend's /chat endpoint (see openspec change
// voice-portfolio-agent, tasks.md section 2).
//
// The <dialog> is a transparent full-viewport flex container, not the
// window itself: that is what lets the call-to-action sit beside the
// terminal window on desktop and below it on mobile. Anything outside the
// dialog's own subtree would be inert while showModal() is active, so
// floating chrome has to live in here.
//
// Voice mode (tasks.md section 3) is feature-detected via
// PUBLIC_ASSISTANT_VOICE_URL: unset, the control renders disabled with a
// reason (per design.md's "disabled-with-reason, not hidden" decision)
// rather than faking a working toggle. Choosing voice swaps this same
// dialog into call mode, which opens on a pre-call screen -- the session
// limit and shared quota are disclosed there *before* the microphone is
// touched or a backend session is claimed.
interface Props {
  locale: 'en' | 'de' | 'vi';
  labels: {
    dialogLabel: string;
    close: string;
    disclosure: string;
    greeting: string;
    placeholder: string;
    send: string;
    suggestedLabel: string;
    questions: string[];
    unavailable: string;
    rateLimited: string;
    inputTooLong: string;
    voiceButton: string;
    voiceStop: string;
    voiceUnavailable: string;
    voiceUnavailableLocale: string;
    voiceDisclosure: string;
    voiceConnecting: string;
    voiceListening: string;
    voiceReconnecting: string;
    voiceEnded: string;
    voiceQuotaReached: string;
    voiceMicDenied: string;
    voiceError: string;
    voiceCallHint: string;
    voiceCallLimit: string;
    callAiNotice: string;
    callStart: string;
    callEnd: string;
    callBack: string;
    callYou: string;
    callAssistant: string;
    callYourTurn: string;
    callSpeaking: string;
    callSilenceEnded: string;
    callTimeLeft: string;
  };
}

const { locale, labels } = Astro.props;

// Live voice is English/German only (non-goal in proposal.md: Vietnamese
// stays text-only), enforced here even before the backend endpoint exists.
const voiceUrl = import.meta.env.PUBLIC_ASSISTANT_VOICE_URL;
const voiceUnavailableReason =
  locale === 'vi' ? labels.voiceUnavailableLocale : !voiceUrl ? labels.voiceUnavailable : null;
const callLabels = {
  connecting: labels.voiceConnecting,
  listening: labels.voiceListening,
  reconnecting: labels.voiceReconnecting,
  ended: labels.voiceEnded,
  quotaReached: labels.voiceQuotaReached,
  micDenied: labels.voiceMicDenied,
  error: labels.voiceError,
  you: labels.callYou,
  assistant: labels.callAssistant,
  yourTurn: labels.callYourTurn,
  speaking: labels.callSpeaking,
  silenceEnded: labels.callSilenceEnded,
};
---

<dialog
  class="assistant-dialog"
  id="assistant-dialog"
  aria-label={labels.dialogLabel}
  data-mode="chat"
  data-locale={locale}
  data-unavailable={labels.unavailable}
  data-rate-limited={labels.rateLimited}
  data-input-too-long={labels.inputTooLong}
  data-voice-url={voiceUrl ?? ''}
  data-call-labels={JSON.stringify(callLabels)}
>
  <div class="assistant-dialog__window">
    <div class="assistant-dialog__chrome">
      <span class="assistant-dialog__dot assistant-dialog__dot--red" aria-hidden="true"></span>
      <span class="assistant-dialog__dot assistant-dialog__dot--amber" aria-hidden="true"></span>
      <span class="assistant-dialog__dot assistant-dialog__dot--green" aria-hidden="true"></span>
      <span class="assistant-dialog__path" data-assistant-path aria-hidden="true">$ ai-assistant --chat</span>
      <span class="assistant-dialog__timer" data-call-timer aria-label={labels.callTimeLeft} hidden>10:00</span>
      <button
        type="button"
        class="assistant-dialog__close"
        data-assistant-dialog-close
        aria-label={labels.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <div class="assistant-dialog__panel" data-assistant-chat>
      <p class="assistant-dialog__disclosure">{labels.disclosure}</p>
      <div class="assistant-dialog__messages" data-assistant-messages role="log" aria-live="polite">
        <p class="assistant-dialog__message assistant-dialog__message--assistant">{labels.greeting}</p>
        <div class="assistant-dialog__chips" data-assistant-chips>
          <p class="assistant-dialog__chips-label">{labels.suggestedLabel}</p>
          <div class="assistant-dialog__chips-list">
            {
              labels.questions.map((question) => (
                <button type="button" class="assistant-dialog__chip" data-assistant-chip>
                  {question}
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <form class="assistant-dialog__form" data-assistant-form>
        <input
          type="text"
          class="assistant-dialog__input"
          data-assistant-input
          placeholder={labels.placeholder}
          aria-label={labels.placeholder}
          autocomplete="off"
          maxlength="1000"
        />
        <button type="submit" class="assistant-dialog__submit" aria-label={labels.send}>
          {labels.send}
        </button>
      </form>
    </div>

    <div class="assistant-dialog__panel assistant-call" data-assistant-call hidden>
      <div class="assistant-call__meters">
        <p class="assistant-call__meter">
          <span class="assistant-call__meter-label">{labels.callYou}</span>
          <span class="assistant-call__meter-bars assistant-call__meter-bars--user" data-call-meter="user"></span>
        </p>
        <p class="assistant-call__meter">
          <span class="assistant-call__meter-label">{labels.callAssistant}</span>
          <span
            class="assistant-call__meter-bars assistant-call__meter-bars--assistant"
            data-call-meter="assistant"></span>
        </p>
      </div>

      <div class="assistant-call__pre" data-call-pre>
        <p class="assistant-call__message" data-call-message hidden></p>
        <p class="assistant-call__notice">{labels.callAiNotice}</p>
        <p class="assistant-call__disclosure">{labels.voiceDisclosure}</p>
        <div class="assistant-call__actions">
          <button type="button" class="assistant-call__action assistant-call__action--start" data-call-start>
            {labels.callStart}
          </button>
          <button type="button" class="assistant-call__action" data-call-back>{labels.callBack}</button>
        </div>
      </div>

      <div class="assistant-call__live" data-call-live hidden>
        <p class="assistant-call__status" data-call-status></p>
        <div class="assistant-call__transcript" data-call-transcript role="log" aria-live="polite"></div>
        <div class="assistant-call__actions">
          <button type="button" class="assistant-call__action assistant-call__action--end" data-call-end>
            {labels.callEnd}
          </button>
        </div>
      </div>
    </div>
  </div>

  <aside class="assistant-dialog__cta" data-assistant-cta>
    <button
      type="button"
      class="assistant-dialog__call-button"
      data-assistant-voice-toggle
      aria-label={labels.voiceCallHint}
      disabled={voiceUnavailableReason !== null}
      title={voiceUnavailableReason ?? undefined}
    >
      <span class="assistant-dialog__ping" data-assistant-ping aria-hidden="true"></span>
      <svg class="assistant-dialog__mic" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"></path>
        <path
          d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>
    <p class="assistant-dialog__cta-cmd">{labels.voiceButton}</p>
    <p class="assistant-dialog__cta-hint" data-assistant-voice-note>
      {voiceUnavailableReason ?? labels.voiceCallHint}
    </p>
    <p class="assistant-dialog__cta-limit">{labels.voiceCallLimit}</p>
  </aside>
</dialog>

<style>
  /* The dialog is the layout surface; the window inside it is what reads as
     a terminal. Setting display on a <dialog> overrides the UA's
     display:none for the closed state, so that has to be restored. */
  .assistant-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: var(--space-4);
    border: 0;
    background: none;
    color: var(--color-text);
    font-family: inherit;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }

  .assistant-dialog:not([open]) {
    display: none;
  }

  .assistant-dialog::backdrop {
    background: rgb(13 17 23 / 58%);
    backdrop-filter: blur(3px);
  }

  .assistant-dialog__window {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    width: min(75vw, 1100px);
    /* dvh tracks the *actual* visible viewport; on mobile, vh is the height
       with the browser's address bar hidden, which overstates what's on
       screen and pushed the top of the dialog above the fold. */
    height: min(80vh, 860px);
    height: min(80dvh, 860px);
    max-height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    overflow: hidden;
    box-shadow:
      0 24px 80px rgb(0 0 0 / 65%),
      0 0 32px color-mix(in srgb, var(--color-accent-green) 14%, transparent);
  }

  .assistant-dialog__panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1 1 auto;
  }

  .assistant-dialog__panel[hidden] {
    display: none;
  }

  .assistant-dialog__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 46px;
    flex: 0 0 auto;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .assistant-dialog__dot {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .assistant-dialog__dot--red {
    background: var(--color-accent-red);
  }

  .assistant-dialog__dot--amber {
    background: var(--color-accent-amber);
  }

  .assistant-dialog__dot--green {
    background: var(--color-accent-green);
  }

  .assistant-dialog__path {
    min-width: 0;
    flex: 1;
    margin-left: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Tabular figures: proportional digits make the seconds column jitter on
     every tick, which reads as a glitch rather than a clock. */
  .assistant-dialog__timer {
    flex: 0 0 auto;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .assistant-dialog__timer[data-level='warn'] {
    color: var(--color-accent-amber);
  }

  .assistant-dialog__timer[data-level='critical'] {
    color: var(--color-accent-red);
  }

  .assistant-dialog__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .assistant-dialog__close:hover,
  .assistant-dialog__close:focus-visible {
    color: var(--color-text);
    border-color: var(--color-accent-red);
    background: color-mix(in srgb, var(--color-accent-red) 10%, transparent);
  }

  .assistant-dialog__disclosure {
    flex: 0 0 auto;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    border-bottom: 1px solid var(--color-border);
  }

  .assistant-dialog__messages {
    flex: 1 1 auto;
    min-height: 120px;
    overflow-y: auto;
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Message bubbles and transcript lines are built in script, so they never
     carry Astro's scoping attribute and a scoped rule cannot match them --
     these have to opt out of scoping to style anything but the greeting. */
  :global(.assistant-dialog__message) {
    margin: 0;
    max-width: 88%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(.assistant-dialog__message--user) {
    align-self: flex-end;
    background: color-mix(in srgb, var(--color-accent-green) 16%, transparent);
    color: var(--color-text);
  }

  :global(.assistant-dialog__message--assistant) {
    align-self: flex-start;
    background: var(--color-surface);
    color: var(--color-text);
  }

  :global(.assistant-dialog__message--error) {
    align-self: flex-start;
    background: color-mix(in srgb, var(--color-accent-red) 14%, transparent);
    color: var(--color-text);
  }

  .assistant-dialog__chips {
    flex: 0 0 auto;
    padding-top: var(--space-1);
  }

  .assistant-dialog__chips[hidden] {
    display: none;
  }

  .assistant-dialog__chips-label {
    margin: 0 0 var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .assistant-dialog__chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .assistant-dialog__chip {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .assistant-dialog__chip:hover,
  .assistant-dialog__chip:focus-visible {
    color: var(--color-accent-green);
    border-color: var(--color-accent-green);
  }

  .assistant-dialog__form {
    flex: 0 0 auto;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .assistant-dialog__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9375rem;
  }

  .assistant-dialog__input:focus-visible {
    outline: none;
    border-color: var(--color-accent-green);
  }

  .assistant-dialog__input:disabled {
    opacity: 0.6;
  }

  .assistant-dialog__submit {
    flex: 0 0 auto;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-accent-green);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent-green) 12%, transparent);
    color: var(--color-accent-green);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background 160ms ease;
  }

  .assistant-dialog__submit:hover:not(:disabled),
  .assistant-dialog__submit:focus-visible {
    background: color-mix(in srgb, var(--color-accent-green) 22%, transparent);
  }

  .assistant-dialog__submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* ---- call-to-action -------------------------------------------------- */

  .assistant-dialog__cta {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    width: 15rem;
  }

  .assistant-dialog__cta[hidden] {
    display: none;
  }

  .assistant-dialog__call-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    margin-bottom: var(--space-2);
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-accent-cyan) 55%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent-cyan) 14%, transparent);
    color: var(--color-accent-cyan);
    cursor: pointer;
    transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .assistant-dialog__call-button:not(:disabled):hover,
  .assistant-dialog__call-button:not(:disabled):focus-visible {
    background: color-mix(in srgb, var(--color-accent-cyan) 24%, transparent);
    border-color: var(--color-accent-cyan);
    transform: translateY(-1px);
  }

  .assistant-dialog__call-button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .assistant-dialog__mic {
    width: 34px;
    height: 34px;
  }

  /* Three pings on open, then silence: enough to pull the eye without
     leaving something permanently flashing on the page. */
  .assistant-dialog__ping {
    position: absolute;
    inset: -7px;
    border: 1px solid var(--color-accent-cyan);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .assistant-dialog__cta[data-ping] .assistant-dialog__ping {
    animation: assistant-ping 2200ms ease-out 3;
  }

  @keyframes assistant-ping {
    0% {
      transform: scale(0.94);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  .assistant-dialog__cta-cmd {
    margin: 0;
    color: var(--color-accent-cyan);
    font-size: 0.875rem;
  }

  /* The one blinking thing in the interface, and it is a terminal cursor --
     the glyph that already means "waiting for your input". */
  .assistant-dialog__cta-cmd::after {
    content: '▋';
    margin-left: 0.15em;
    animation: assistant-cursor 1060ms steps(1) infinite;
  }

  @keyframes assistant-cursor {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  .assistant-dialog__cta-hint {
    margin: 0;
    color: var(--color-text);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .assistant-dialog__cta-limit {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .assistant-dialog__call-button:disabled ~ .assistant-dialog__cta-cmd,
  .assistant-dialog__call-button:disabled ~ .assistant-dialog__cta-limit {
    display: none;
  }

  /* ---- call mode ------------------------------------------------------- */

  .assistant-call {
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
  }

  .assistant-call__meters {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .assistant-call__meter {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    min-width: 0;
  }

  .assistant-call__meter-label {
    flex: 0 0 5.5rem;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .assistant-call__meter-bars {
    min-width: 0;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .assistant-call__meter-bars--user {
    color: var(--color-accent-green);
  }

  .assistant-call__meter-bars--assistant {
    color: var(--color-accent-cyan);
  }

  .assistant-call__pre,
  .assistant-call__live {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 0;
  }

  /* Pre-call has little content, so centring it reads as a deliberate
     "ready to call" screen instead of text stranded under the meters. */
  .assistant-call__pre {
    justify-content: center;
    align-items: flex-start;
    max-width: 46rem;
  }

  .assistant-call__pre[hidden],
  .assistant-call__live[hidden] {
    display: none;
  }

  .assistant-call__message {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent-amber) 14%, transparent);
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .assistant-call__message[hidden] {
    display: none;
  }

  .assistant-call__notice {
    margin: 0;
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .assistant-call__disclosure {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .assistant-call__status {
    margin: 0;
    color: var(--color-text);
    font-size: 0.8125rem;
  }

  .assistant-call__status[data-waiting]::after {
    content: ' ▋';
    animation: assistant-cursor 1060ms steps(1) infinite;
  }

  .assistant-call__transcript {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.assistant-call__line) {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  :global(.assistant-call__line-speaker) {
    flex: 0 0 5.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-top: 0.28em;
  }

  :global(.assistant-call__line--user .assistant-call__line-speaker) {
    color: var(--color-accent-green);
  }

  :global(.assistant-call__line--assistant .assistant-call__line-speaker) {
    color: var(--color-accent-cyan);
  }

  :global(.assistant-call__line-body) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .assistant-call__actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .assistant-call__action {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .assistant-call__action:hover,
  .assistant-call__action:focus-visible {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .assistant-call__action--start {
    border-color: color-mix(in srgb, var(--color-accent-cyan) 55%, transparent);
    background: color-mix(in srgb, var(--color-accent-cyan) 14%, transparent);
    color: var(--color-accent-cyan);
  }

  .assistant-call__action--start::after {
    content: '▋';
    margin-left: 0.35em;
    animation: assistant-cursor 1060ms steps(1) infinite;
  }

  .assistant-call__action--start:hover,
  .assistant-call__action--start:focus-visible {
    border-color: var(--color-accent-cyan);
    background: color-mix(in srgb, var(--color-accent-cyan) 24%, transparent);
    color: var(--color-accent-cyan);
  }

  .assistant-call__action--end {
    border-color: color-mix(in srgb, var(--color-accent-red) 55%, transparent);
    color: var(--color-accent-red);
  }

  .assistant-call__action--end:hover,
  .assistant-call__action--end:focus-visible {
    border-color: var(--color-accent-red);
    background: color-mix(in srgb, var(--color-accent-red) 12%, transparent);
    color: var(--color-accent-red);
  }

  /* Below this width there is no room for a column beside the window, so
     the call-to-action becomes a row underneath it and the window shrinks
     to make space rather than pushing it off screen. */
  @media (max-width: 900px) {
    .assistant-dialog {
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .assistant-dialog__window {
      width: 100%;
      height: auto;
      flex: 1 1 auto;
    }

    .assistant-dialog__cta {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      align-items: center;
      column-gap: var(--space-3);
      width: 100%;
    }

    .assistant-dialog__call-button {
      grid-row: 1 / span 2;
      width: 60px;
      height: 60px;
      margin-bottom: 0;
    }

    .assistant-dialog__mic {
      width: 26px;
      height: 26px;
    }

    .assistant-dialog__cta-cmd {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .assistant-dialog__path {
      display: none;
    }

    .assistant-call {
      padding: var(--space-3) var(--space-2);
    }

    .assistant-call__meter-label,
    .assistant-call__line-speaker {
      flex-basis: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .assistant-dialog__cta[data-ping] .assistant-dialog__ping {
      animation: none;
    }

    .assistant-dialog__cta-cmd::after,
    .assistant-call__action--start::after,
    .assistant-call__status[data-waiting]::after {
      animation: none;
      opacity: 1;
    }

    .assistant-dialog__call-button {
      transition: none;
    }
  }
</style>

<script>
  import { CallMode, type CallModeLabels } from './assistant-call-mode';

  // Set via the PUBLIC_ASSISTANT_API_URL repository variable in GitHub Actions
  // (see .github/workflows/deploy.yml) - not committed to source.
  const API_URL: string | undefined = import.meta.env.PUBLIC_ASSISTANT_API_URL;
  const SESSION_STORAGE_KEY = 'assistant-session-id';

  type MessageRole = 'user' | 'assistant' | 'error';

  const dialog = document.querySelector<HTMLDialogElement>('#assistant-dialog');
  const messagesEl = dialog?.querySelector<HTMLDivElement>('[data-assistant-messages]');
  const chipsEl = dialog?.querySelector<HTMLDivElement>('[data-assistant-chips]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-assistant-form]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-assistant-input]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const chatPanel = dialog?.querySelector<HTMLDivElement>('[data-assistant-chat]');
  const callPanel = dialog?.querySelector<HTMLDivElement>('[data-assistant-call]');
  const ctaEl = dialog?.querySelector<HTMLElement>('[data-assistant-cta]');
  const voiceToggle = dialog?.querySelector<HTMLButtonElement>('[data-assistant-voice-toggle]');
  const pathEl = dialog?.querySelector<HTMLSpanElement>('[data-assistant-path]');

  const locale = dialog?.dataset.locale ?? 'en';
  const unavailableMessage = dialog?.dataset.unavailable ?? '';
  const rateLimitedMessage = dialog?.dataset.rateLimited ?? '';
  const inputTooLongMessage = dialog?.dataset.inputTooLong ?? '';
  const voiceUrl = dialog?.dataset.voiceUrl || undefined;
  const callLabels: CallModeLabels | null = dialog?.dataset.callLabels
    ? JSON.parse(dialog.dataset.callLabels)
    : null;

  let opener: HTMLElement | null = null;
  let sending = false;
  let callMode: CallMode | null = null;

  function getSessionId(): string {
    let id = sessionStorage.getItem(SESSION_STORAGE_KEY);
    if (!id) {
      id = crypto.randomUUID();
      sessionStorage.setItem(SESSION_STORAGE_KEY, id);
    }
    return id;
  }

  function appendMessage(role: MessageRole, text: string): HTMLParagraphElement {
    const bubble = document.createElement('p');
    bubble.className = `assistant-dialog__message assistant-dialog__message--${role}`;
    bubble.textContent = text;
    messagesEl?.appendChild(bubble);
    if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
    return bubble;
  }

  function setSending(value: boolean) {
    sending = value;
    if (input) input.disabled = value;
    if (submitButton) submitButton.disabled = value;
  }

  function enterCallMode() {
    if (!dialog || !callMode) return;
    dialog.dataset.mode = 'call';
    chatPanel?.setAttribute('hidden', '');
    callPanel?.removeAttribute('hidden');
    ctaEl?.setAttribute('hidden', '');
    if (pathEl) pathEl.textContent = '$ ai-assistant --live';
    callMode.showPreCall();
  }

  function exitCallMode() {
    if (!dialog) return;
    dialog.dataset.mode = 'chat';
    callPanel?.setAttribute('hidden', '');
    chatPanel?.removeAttribute('hidden');
    ctaEl?.removeAttribute('hidden');
    if (pathEl) pathEl.textContent = '$ ai-assistant --chat';
  }

  if (voiceUrl && callLabels && callPanel && dialog) {
    callMode = new CallMode(dialog, {
      labels: callLabels,
      voiceUrl,
      locale,
      onExit: exitCallMode,
    });
  }

  voiceToggle?.addEventListener('click', () => {
    if (!callMode) return;
    enterCallMode();
  });

  if (!API_URL) {
    chipsEl?.setAttribute('hidden', '');
    if (input) input.disabled = true;
    if (submitButton) submitButton.disabled = true;
    appendMessage('error', unavailableMessage);
  }

  async function sendMessage(text: string) {
    if (!API_URL || !text.trim() || sending) return;
    chipsEl?.setAttribute('hidden', '');
    appendMessage('user', text);
    setSending(true);

    const bubble = appendMessage('assistant', '');
    try {
      const response = await fetch(`${API_URL}/chat`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ message: text, locale, session_id: getSessionId() }),
      });

      if (!response.ok || !response.body) {
        bubble.remove();
        if (response.status === 429) appendMessage('error', rateLimitedMessage);
        else if (response.status === 400) appendMessage('error', inputTooLongMessage);
        else appendMessage('error', unavailableMessage);
        return;
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        bubble.textContent = (bubble.textContent ?? '') + decoder.decode(value, { stream: true });
        if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
      }
    } catch {
      bubble.remove();
      appendMessage('error', unavailableMessage);
    } finally {
      setSending(false);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = input?.value ?? '';
    if (input) input.value = '';
    void sendMessage(text);
  });

  chipsEl?.addEventListener('click', (event) => {
    const chip = event.target instanceof HTMLElement ? event.target.closest('[data-assistant-chip]') : null;
    if (chip?.textContent) void sendMessage(chip.textContent);
  });

  const openAssistantDialog = (source: HTMLElement | null) => {
    if (!dialog || dialog.open) return;
    opener = source;
    dialog.showModal();
    input?.focus();
    // Re-trigger the attention pings on each open: a CSS animation with a
    // finite iteration count only replays if the class is removed first.
    ctaEl?.removeAttribute('data-ping');
    void ctaEl?.offsetWidth;
    ctaEl?.setAttribute('data-ping', '');
  };

  const closeAssistantDialog = () => {
    if (dialog?.open) dialog.close();
  };

  const isFocusable = (el: HTMLElement) => document.body.contains(el) && !el.closest('[hidden]');

  dialog?.addEventListener('close', () => {
    callMode?.stop();
    exitCallMode();
    // The opener is usually the overlay's still-visible "ask my assistant"
    // button, but fall back to the page's main content so focus doesn't
    // silently drop to <body> if the opener is ever gone or hidden.
    const target = opener && isFocusable(opener) ? opener : document.getElementById('main');
    opener = null;
    // Deferred: the browser's own focus-restoration-to-previously-focused-
    // element (which runs as part of native dialog close) would otherwise
    // race this call and can win, leaving focus on the (now-hidden) opener.
    setTimeout(() => target?.focus({ preventScroll: true }), 0);
  });

  dialog?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-assistant-dialog-close]')) {
      closeAssistantDialog();
      return;
    }
    // The dialog now fills the viewport, so a click landing on the dialog
    // itself (rather than the window or the CTA) is a click on empty space.
    if (event.target === dialog) closeAssistantDialog();
  });

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-open-assistant]');
    if (trigger) openAssistantDialog(trigger);
  });
</script>
