---
// Sibling dialog opened by any element carrying `data-open-assistant` (see
// `network-intro.astro`'s "ask my assistant" button). Talks to the
// portfolio-voice-agent backend's /chat endpoint (see openspec change
// voice-portfolio-agent, tasks.md section 2).
//
// Voice mode (tasks.md section 3) is feature-detected via
// PUBLIC_ASSISTANT_VOICE_URL: unset, the control renders disabled with a
// reason (per design.md's "disabled-with-reason, not hidden" decision)
// rather than faking a working toggle. When set, assistant-voice-client.ts
// drives the actual live session (mic capture, playback, reconnection)
// against the backend's /ws/voice protocol.
interface Props {
  locale: 'en' | 'de' | 'vi';
  labels: {
    dialogLabel: string;
    close: string;
    disclosure: string;
    placeholder: string;
    send: string;
    suggestedLabel: string;
    questions: string[];
    unavailable: string;
    rateLimited: string;
    inputTooLong: string;
    voiceButton: string;
    voiceStop: string;
    voiceUnavailable: string;
    voiceUnavailableLocale: string;
    voiceDisclosure: string;
    voiceConnecting: string;
    voiceListening: string;
    voiceReconnecting: string;
    voiceEnded: string;
    voiceQuotaReached: string;
    voiceMicDenied: string;
    voiceError: string;
  };
}

const { locale, labels } = Astro.props;

// Live voice is English/German only (non-goal in proposal.md: Vietnamese
// stays text-only), enforced here even before the backend endpoint exists.
const voiceUrl = import.meta.env.PUBLIC_ASSISTANT_VOICE_URL;
const voiceUnavailableReason =
  locale === 'vi' ? labels.voiceUnavailableLocale : !voiceUrl ? labels.voiceUnavailable : null;
const voiceNoteInitialText = voiceUnavailableReason ?? labels.voiceDisclosure;
const voiceStatusLabels = {
  button: labels.voiceButton,
  stop: labels.voiceStop,
  idle: voiceNoteInitialText,
  connecting: labels.voiceConnecting,
  listening: labels.voiceListening,
  reconnecting: labels.voiceReconnecting,
  ended: labels.voiceEnded,
  'quota-reached': labels.voiceQuotaReached,
  'mic-denied': labels.voiceMicDenied,
  error: labels.voiceError,
};
---

<dialog
  class="assistant-dialog"
  id="assistant-dialog"
  aria-label={labels.dialogLabel}
  data-locale={locale}
  data-unavailable={labels.unavailable}
  data-rate-limited={labels.rateLimited}
  data-input-too-long={labels.inputTooLong}
  data-voice-url={voiceUrl ?? ''}
  data-voice-labels={JSON.stringify(voiceStatusLabels)}
>
  <div class="assistant-dialog__window">
    <div class="assistant-dialog__chrome">
      <span class="assistant-dialog__dot assistant-dialog__dot--red" aria-hidden="true"></span>
      <span class="assistant-dialog__dot assistant-dialog__dot--amber" aria-hidden="true"></span>
      <span class="assistant-dialog__dot assistant-dialog__dot--green" aria-hidden="true"></span>
      <span class="assistant-dialog__path" aria-hidden="true">$ ai-assistant --chat</span>
      <button
        type="button"
        class="assistant-dialog__close"
        data-assistant-dialog-close
        aria-label={labels.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <p class="assistant-dialog__disclosure">{labels.disclosure}</p>
    <div class="assistant-dialog__voice-row">
      <button
        type="button"
        class="assistant-dialog__voice"
        data-assistant-voice-toggle
        aria-label={labels.voiceButton}
        aria-pressed="false"
        disabled={voiceUnavailableReason !== null}
        title={voiceUnavailableReason ?? undefined}
      >
        {labels.voiceButton}
      </button>
      <p class="assistant-dialog__voice-note" data-assistant-voice-note>
        {voiceNoteInitialText}
      </p>
    </div>
    <div class="assistant-dialog__messages" data-assistant-messages role="log" aria-live="polite">
      <div class="assistant-dialog__chips" data-assistant-chips>
        <p class="assistant-dialog__chips-label">{labels.suggestedLabel}</p>
        <div class="assistant-dialog__chips-list">
          {
            labels.questions.map((question) => (
              <button type="button" class="assistant-dialog__chip" data-assistant-chip>
                {question}
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <form class="assistant-dialog__form" data-assistant-form>
      <input
        type="text"
        class="assistant-dialog__input"
        data-assistant-input
        placeholder={labels.placeholder}
        aria-label={labels.placeholder}
        autocomplete="off"
        maxlength="1000"
      />
      <button type="submit" class="assistant-dialog__submit" aria-label={labels.send}>
        {labels.send}
      </button>
    </form>
  </div>
</dialog>

<style>
  .assistant-dialog {
    width: min(75vw, 1100px, calc(100vw - 2rem));
    max-width: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    overflow: hidden;
    box-shadow:
      0 24px 80px rgb(0 0 0 / 65%),
      0 0 32px color-mix(in srgb, var(--color-accent-green) 14%, transparent);
  }

  .assistant-dialog::backdrop {
    background: rgb(13 17 23 / 58%);
    backdrop-filter: blur(3px);
  }

  .assistant-dialog__window {
    display: flex;
    flex-direction: column;
    /* dvh tracks the *actual* visible viewport; on mobile, vh is the height
       with the browser's address bar hidden, which overstates what's on
       screen and pushed the top of the dialog (chrome bar, voice button)
       above the fold since the native <dialog> centers on the real one. */
    height: min(80vh, 860px, calc(100vh - 4rem));
    height: min(80dvh, 860px, calc(100dvh - 4rem));
  }

  .assistant-dialog__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 46px;
    flex: 0 0 auto;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .assistant-dialog__dot {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .assistant-dialog__dot--red {
    background: var(--color-accent-red);
  }

  .assistant-dialog__dot--amber {
    background: var(--color-accent-amber);
  }

  .assistant-dialog__dot--green {
    background: var(--color-accent-green);
  }

  .assistant-dialog__path {
    min-width: 0;
    flex: 1;
    margin-left: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .assistant-dialog__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .assistant-dialog__close:hover,
  .assistant-dialog__close:focus-visible {
    color: var(--color-text);
    border-color: var(--color-accent-red);
    background: color-mix(in srgb, var(--color-accent-red) 10%, transparent);
  }

  .assistant-dialog__disclosure {
    flex: 0 0 auto;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    border-bottom: 1px solid var(--color-border);
  }

  .assistant-dialog__voice-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .assistant-dialog__voice {
    flex: 0 0 auto;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .assistant-dialog__voice:not(:disabled):hover,
  .assistant-dialog__voice:not(:disabled):focus-visible {
    color: var(--color-accent-green);
    border-color: var(--color-accent-green);
  }

  .assistant-dialog__voice:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .assistant-dialog__voice-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .assistant-dialog__messages {
    flex: 1 1 auto;
    min-height: 160px;
    overflow-y: auto;
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .assistant-dialog__message {
    margin: 0;
    max-width: 88%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .assistant-dialog__message--user {
    align-self: flex-end;
    background: color-mix(in srgb, var(--color-accent-green) 16%, transparent);
    color: var(--color-text);
  }

  .assistant-dialog__message--assistant {
    align-self: flex-start;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .assistant-dialog__message--error {
    align-self: flex-start;
    background: color-mix(in srgb, var(--color-accent-red) 14%, transparent);
    color: var(--color-text);
  }

  .assistant-dialog__chips {
    flex: 0 0 auto;
    padding: 0 var(--space-3) var(--space-2);
  }

  .assistant-dialog__chips[hidden] {
    display: none;
  }

  .assistant-dialog__chips-label {
    margin: 0 0 var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .assistant-dialog__chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .assistant-dialog__chip {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .assistant-dialog__chip:hover,
  .assistant-dialog__chip:focus-visible {
    color: var(--color-accent-green);
    border-color: var(--color-accent-green);
  }

  .assistant-dialog__form {
    flex: 0 0 auto;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .assistant-dialog__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9375rem;
  }

  .assistant-dialog__input:focus-visible {
    outline: none;
    border-color: var(--color-accent-green);
  }

  .assistant-dialog__input:disabled {
    opacity: 0.6;
  }

  .assistant-dialog__submit {
    flex: 0 0 auto;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-accent-green);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent-green) 12%, transparent);
    color: var(--color-accent-green);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background 160ms ease;
  }

  .assistant-dialog__submit:hover:not(:disabled),
  .assistant-dialog__submit:focus-visible {
    background: color-mix(in srgb, var(--color-accent-green) 22%, transparent);
  }

  .assistant-dialog__submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  @media (max-width: 640px) {
    .assistant-dialog {
      width: calc(100vw - 1rem);
    }

    .assistant-dialog__path {
      display: none;
    }

    .assistant-dialog__window {
      height: min(85vh, calc(100vh - 1.5rem));
      height: min(85dvh, calc(100dvh - 1.5rem));
    }
  }
</style>

<script>
  import { VoiceClient, type VoiceStatus } from './assistant-voice-client';

  // Set via the PUBLIC_ASSISTANT_API_URL repository variable in GitHub Actions
  // (see .github/workflows/deploy.yml) - not committed to source.
  const API_URL: string | undefined = import.meta.env.PUBLIC_ASSISTANT_API_URL;
  const SESSION_STORAGE_KEY = 'assistant-session-id';

  type MessageRole = 'user' | 'assistant' | 'error';

  const dialog = document.querySelector<HTMLDialogElement>('#assistant-dialog');
  const messagesEl = dialog?.querySelector<HTMLDivElement>('[data-assistant-messages]');
  const chipsEl = dialog?.querySelector<HTMLDivElement>('[data-assistant-chips]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-assistant-form]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-assistant-input]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const voiceToggle = dialog?.querySelector<HTMLButtonElement>('[data-assistant-voice-toggle]');
  const voiceNote = dialog?.querySelector<HTMLParagraphElement>('[data-assistant-voice-note]');

  const locale = dialog?.dataset.locale ?? 'en';
  const unavailableMessage = dialog?.dataset.unavailable ?? '';
  const rateLimitedMessage = dialog?.dataset.rateLimited ?? '';
  const inputTooLongMessage = dialog?.dataset.inputTooLong ?? '';
  const voiceUrl = dialog?.dataset.voiceUrl || undefined;
  const voiceLabels: Record<VoiceStatus | 'button' | 'stop', string> | null = dialog?.dataset.voiceLabels
    ? JSON.parse(dialog.dataset.voiceLabels)
    : null;

  let opener: HTMLElement | null = null;
  let sending = false;
  let voiceClient: VoiceClient | null = null;
  let voiceActive = false;

  function getSessionId(): string {
    let id = sessionStorage.getItem(SESSION_STORAGE_KEY);
    if (!id) {
      id = crypto.randomUUID();
      sessionStorage.setItem(SESSION_STORAGE_KEY, id);
    }
    return id;
  }

  function appendMessage(role: MessageRole, text: string): HTMLParagraphElement {
    const bubble = document.createElement('p');
    bubble.className = `assistant-dialog__message assistant-dialog__message--${role}`;
    bubble.textContent = text;
    messagesEl?.appendChild(bubble);
    if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
    return bubble;
  }

  function setSending(value: boolean) {
    sending = value;
    if (input) input.disabled = value || voiceActive;
    if (submitButton) submitButton.disabled = value || voiceActive;
  }

  function applyVoiceStatus(status: VoiceStatus) {
    if (!voiceLabels) return;
    voiceActive = status === 'connecting' || status === 'listening' || status === 'reconnecting';
    if (voiceNote) voiceNote.textContent = voiceLabels[status];
    if (voiceToggle) {
      const label = voiceActive ? voiceLabels.stop : voiceLabels.button;
      voiceToggle.textContent = label;
      voiceToggle.setAttribute('aria-label', label);
      voiceToggle.setAttribute('aria-pressed', String(voiceActive));
    }
    if (input) input.disabled = sending || voiceActive;
    if (submitButton) submitButton.disabled = sending || voiceActive;
    if (voiceActive) chipsEl?.setAttribute('hidden', '');
  }

  voiceToggle?.addEventListener('click', () => {
    if (!voiceUrl) return;
    if (voiceActive) {
      voiceClient?.stop();
      return;
    }
    if (!voiceClient) {
      voiceClient = new VoiceClient({ wsUrl: voiceUrl, locale, onStatusChange: applyVoiceStatus });
    }
    void voiceClient.start();
  });

  if (!API_URL) {
    chipsEl?.setAttribute('hidden', '');
    if (input) input.disabled = true;
    if (submitButton) submitButton.disabled = true;
    appendMessage('error', unavailableMessage);
  }

  async function sendMessage(text: string) {
    if (!API_URL || !text.trim() || sending || voiceActive) return;
    chipsEl?.setAttribute('hidden', '');
    appendMessage('user', text);
    setSending(true);

    const bubble = appendMessage('assistant', '');
    try {
      const response = await fetch(`${API_URL}/chat`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ message: text, locale, session_id: getSessionId() }),
      });

      if (!response.ok || !response.body) {
        bubble.remove();
        if (response.status === 429) appendMessage('error', rateLimitedMessage);
        else if (response.status === 400) appendMessage('error', inputTooLongMessage);
        else appendMessage('error', unavailableMessage);
        return;
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        bubble.textContent = (bubble.textContent ?? '') + decoder.decode(value, { stream: true });
        if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
      }
    } catch {
      bubble.remove();
      appendMessage('error', unavailableMessage);
    } finally {
      setSending(false);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = input?.value ?? '';
    if (input) input.value = '';
    void sendMessage(text);
  });

  chipsEl?.addEventListener('click', (event) => {
    const chip = event.target instanceof HTMLElement ? event.target.closest('[data-assistant-chip]') : null;
    if (chip?.textContent) void sendMessage(chip.textContent);
  });

  const openAssistantDialog = (source: HTMLElement | null) => {
    if (!dialog || dialog.open) return;
    opener = source;
    dialog.showModal();
    input?.focus();
  };

  const closeAssistantDialog = () => {
    if (dialog?.open) dialog.close();
  };

  const isFocusable = (el: HTMLElement) => document.body.contains(el) && !el.closest('[hidden]');

  dialog?.addEventListener('close', () => {
    voiceClient?.stop();
    // The opener is usually the overlay's still-visible "ask my assistant"
    // button, but fall back to the page's main content so focus doesn't
    // silently drop to <body> if the opener is ever gone or hidden.
    const target = opener && isFocusable(opener) ? opener : document.getElementById('main');
    opener = null;
    // Deferred: the browser's own focus-restoration-to-previously-focused-
    // element (which runs as part of native dialog close) would otherwise
    // race this call and can win, leaving focus on the (now-hidden) opener.
    setTimeout(() => target?.focus({ preventScroll: true }), 0);
  });

  dialog?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-assistant-dialog-close]')) {
      closeAssistantDialog();
      return;
    }

    if (event.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    const outside =
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom;
    if (outside) closeAssistantDialog();
  });

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-open-assistant]');
    if (trigger) openAssistantDialog(trigger);
  });
</script>
