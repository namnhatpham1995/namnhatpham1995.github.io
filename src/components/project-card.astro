---
import type { ProjectEntry } from '../i18n/content/types';

interface Props {
  entry: ProjectEntry;
  technologiesLabel: string;
}

const { entry, technologiesLabel } = Astro.props;
---

<article class="project-card">
  <header class="project-card__header">
    <h3 class="project-card__title">{entry.title}</h3>
    {entry.dates && <span class="project-card__dates">{entry.dates}</span>}
  </header>
  <ul class="project-card__description">
    {entry.description.map((line) => <li>{line}</li>)}
  </ul>
  <ul class="project-card__tech" aria-label={technologiesLabel}>
    {
      entry.tech.map((tech) => (
        <li>
          <span aria-hidden="true">#</span>
          {tech}
        </li>
      ))
    }
  </ul>
  <p class="project-card__links">
    {
      entry.links.map((link, i) => (
        <>
          {i > 0 && ' · '}
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </>
      ))
    }
  </p>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-4);
    background: var(--color-surface);
  }

  .project-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .project-card__title {
    margin: 0;
    font-size: 1rem;
  }

  .project-card__dates {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .project-card__description {
    margin: 0 0 var(--space-2);
    padding-left: 1.1em;
  }

  .project-card__description li {
    margin-bottom: var(--space-1);
  }

  .project-card__tech {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-card__tech li {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .project-card__tech span {
    color: var(--color-accent-amber);
  }

  .project-card__links {
    margin: 0;
    font-size: 0.875rem;
  }
</style>
