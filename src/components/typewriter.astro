---
import type { SummarySegment } from '../i18n/content/types';

interface Props {
  segments: SummarySegment[];
}

const { segments } = Astro.props;
const text = segments.map((segment) => segment.text).join('');
---

<p class="typewriter" data-typewriter data-text={text} aria-label={text}>
  <span class="typewriter__text" aria-hidden="true">
    {
      segments.map((segment) =>
        segment.strong ? (
          <strong class="typewriter__segment" data-segment={segment.text}>{segment.text}</strong>
        ) : (
          <span class="typewriter__segment" data-segment={segment.text}>{segment.text}</span>
        ),
      )
    }
  </span><span class="typewriter__cursor" aria-hidden="true">▌</span>
</p>

<style>
  .typewriter {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .typewriter__cursor {
    display: inline-block;
    color: var(--color-accent-green);
    animation: blink 1s step-end infinite;
  }

  .typewriter__text strong {
    color: var(--color-text);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter__cursor {
      animation: none;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach((el) => {
    if (reduceMotion) return;

    const segmentEls = Array.from(el.querySelectorAll<HTMLElement>('.typewriter__segment'));
    const fullText = el.dataset.text ?? '';
    if (!segmentEls.length || !fullText) return;

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      const segmentTexts = segmentEls.map((segment) => segment.dataset.segment ?? '');
      const delay = Math.max(8, Math.min(28, Math.floor(6_000 / fullText.length)));
      segmentEls.forEach((segment) => {
        segment.textContent = '';
      });

      let segmentIndex = 0;
      let characterIndex = 0;
      const step = () => {
        const segment = segmentEls[segmentIndex];
        const segmentText = segmentTexts[segmentIndex];
        if (!segment || segmentText === undefined) return;

        characterIndex += 1;
        segment.textContent = segmentText.slice(0, characterIndex);

        if (characterIndex >= segmentText.length) {
          segmentIndex += 1;
          characterIndex = 0;
        }

        if (segmentIndex < segmentEls.length) {
          window.setTimeout(step, delay);
        }
      };
      step();
    };

    const networkIntro = document.getElementById('network-intro');
    if (networkIntro && !networkIntro.hidden) {
      document.addEventListener('network-intro:closed', start, { once: true });
    } else {
      start();
    }
  });
</script>
