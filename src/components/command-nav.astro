---
interface NavItem {
  id: string;
  label: string;
}

interface Props {
  items: NavItem[];
  /** When set, renders a button that re-opens the network intro map. */
  mapButtonLabel?: string;
}

const { items, mapButtonLabel } = Astro.props;

import { sectionIcons as icons, networkIcon } from './section-icons';
---

<nav class="command-nav" aria-label="Section navigation">
  <ul class="command-nav__list">
    {
      mapButtonLabel && (
        <li class="command-nav__map-item">
          <button type="button" data-open-network aria-label={mapButtonLabel}>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={networkIcon}
            />
            <span class="command-nav__tooltip">{mapButtonLabel}</span>
          </button>
        </li>
      )
    }
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} data-nav-link data-target={item.id} aria-label={item.label}>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[item.id]}
            />
            <span class="command-nav__tooltip">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .command-nav {
    position: fixed;
    left: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    max-height: 90vh;
    overflow-y: auto;
  }

  .command-nav__list {
    list-style: none;
    margin: 0;
    padding: var(--space-1);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .command-nav__list a,
  .command-nav__list button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-text-muted);
    border-radius: var(--radius);
    border: none;
    background: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }

  .command-nav__list a:hover,
  .command-nav__list a:focus-visible,
  .command-nav__list button:hover,
  .command-nav__list button:focus-visible {
    color: var(--color-text);
  }

  .command-nav__map-item {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-1);
  }

  .command-nav__list a[aria-current='true'] {
    color: var(--color-accent-green);
    background: color-mix(in srgb, var(--color-accent-green) 12%, transparent);
  }

  .command-nav__tooltip {
    position: absolute;
    left: calc(100% + var(--space-2));
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
    font-size: 0.75rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  @media (hover: hover) {
    .command-nav__list a:hover .command-nav__tooltip,
    .command-nav__list a:focus-visible .command-nav__tooltip,
    .command-nav__list button:hover .command-nav__tooltip,
    .command-nav__list button:focus-visible .command-nav__tooltip {
      opacity: 1;
    }
  }

  /* Small screens: collapse the left icon rail into a compact bottom bar so it
     doesn't eat into the narrow content width. */
  @media (max-width: 480px) {
    .command-nav {
      left: 0;
      right: 0;
      top: auto;
      bottom: 0;
      transform: none;
      width: 100%;
      max-height: none;
      border-left: none;
      border-right: none;
      border-bottom: none;
      border-radius: 0;
    }

    .command-nav__list {
      flex-direction: row;
      justify-content: space-between;
      padding: var(--space-1) var(--space-2);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .command-nav__list::-webkit-scrollbar {
      display: none;
    }

    .command-nav__list a,
    .command-nav__list button {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
    }

    /* Horizontal bottom bar: the divider sits to the right, not below. */
    .command-nav__map-item {
      border-bottom: none;
      padding-bottom: 0;
      border-right: 1px solid var(--color-border);
      padding-right: var(--space-1);
    }

    /* Tooltips only ever appear under (hover: hover); touch devices never
       trigger them, but the element still occupies layout space (opacity
       doesn't remove it), which was overflowing the bottom bar's scroll
       width. Drop it from layout entirely at this breakpoint. */
    .command-nav__tooltip {
      display: none;
    }
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const targets = Array.from(links)
    .map((link) => document.getElementById(link.dataset.target ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  // A network-map node click can isolate a single section (see
  // network-intro.astro / portfolio-page.astro). Regular nav-rail links
  // should always behave like normal in-page navigation, so exit that mode
  // first — synchronously, before the anchor's default jump runs.
  links.forEach((link) => {
    link.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('portfolio:exit-section-focus'));
    });
  });

  if (targets.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          links.forEach((link) => {
            link.toggleAttribute('aria-current', link.dataset.target === id);
            if (link.dataset.target === id) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
  }
</script>
