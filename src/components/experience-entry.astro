---
import type { ExperienceEntry } from '../i18n/content/types';
import EmphasizedText from './emphasized-text.astro';

interface Props {
  entry: ExperienceEntry;
  technicalDetailsLabel: string;
}

const { entry, technicalDetailsLabel } = Astro.props;

function shortHash(input: string): string {
  let hash = 0;
  for (let i = 0; i < input.length; i++) {
    hash = (hash * 31 + input.charCodeAt(i)) >>> 0;
  }
  return hash.toString(16).slice(0, 7).padStart(7, '0');
}

const hash = shortHash(entry.role + entry.company + entry.dates);
---

<article class="experience-entry">
  <header class="experience-entry__header">
    <div class="experience-entry__heading">
      <h3 class="experience-entry__role">{entry.role}</h3>
      <p class="experience-entry__meta">{entry.company}</p>
    </div>
    <div class="experience-entry__when">
      <span class="experience-entry__dates">{entry.dates}</span>
      <span class="experience-entry__hash" aria-hidden="true">{hash}</span>
    </div>
  </header>
  <ul class="experience-entry__bullets">
    {entry.bullets.slice(0, 3).map((bullet) => <li><EmphasizedText text={bullet} phrases={entry.emphasis} /></li>)}
  </ul>
  {entry.bullets.length > 3 && (
    <details class="technical-details">
      <summary><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 5 5-5 5" /></svg>{technicalDetailsLabel}</summary>
      <ul class="experience-entry__bullets">
        {entry.bullets.slice(3).map(bullet => <li>{bullet}</li>)}
      </ul>
    </details>
  )}
</article>

<style>
  /* Each role is its own card, like the projects, with who, where and when up front. */
  .experience-entry {
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: var(--space-4);
    background: linear-gradient(130deg, #142e22, var(--color-surface) 72%) padding-box, var(--glass-edge-glow), var(--color-border);
    overflow-wrap: anywhere;
  }

  .experience-entry__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .experience-entry__heading {
    min-width: 0;
  }

  .experience-entry__role {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-accent-gold);
  }

  .experience-entry__meta {
    margin: var(--space-1) 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .experience-entry__when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }

  .experience-entry__dates {
    padding: var(--space-1) var(--space-2);
    border: 1px solid color-mix(in srgb, var(--color-accent-green) 60%, var(--color-border));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent-green) 12%, transparent);
    color: var(--color-accent-green);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .experience-entry__hash {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .experience-entry__bullets {
    margin: 0;
    padding-left: 1.1em;
  }

  .experience-entry__bullets li {
    margin-bottom: var(--space-1);
  }

  @media (max-width: 640px) {
    .experience-entry {
      padding: var(--space-3);
    }

    .experience-entry__when {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
</style>
