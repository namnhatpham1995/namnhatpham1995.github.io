---
import { sectionIcons } from './section-icons';
import LanguageSwitcher from './language-switcher.astro';
import type { Locale } from '../i18n/locale-utils';

interface NodeItem {
  id: string;
  label: string;
}

interface Props {
  locale: Locale;
  /** Peripheral section nodes (everything except the intro/center node). */
  items: NodeItem[];
  introLabel: string;
  name: string;
  role: string;
  photoUrl: string;
  labels: {
    dialogLabel: string;
    hint: string;
    skip: string;
    close: string;
    languageSwitcher: string;
    assistant: string;
  };
}

const { locale, items, introLabel, name, role, photoUrl, labels } = Astro.props;

// Constellation layout. Positions are percent of the stage, one set for a wide
// stage and one for a tall one; each marks the centre of the node's orb. `size`
// is the orb diameter in px at full scale, so heavier sections read bigger.
// `depth` (0–1) scales the pointer parallax: deep nodes drift less.
const layout: Record<string, { land: [number, number]; port: [number, number]; size: number; depth: number }> = {
  intro: { land: [44, 48], port: [50, 40], size: 92, depth: 0.45 },
  experience: { land: [67, 28], port: [74, 21], size: 76, depth: 1 },
  projects: { land: [77, 67], port: [72, 72], size: 76, depth: 1 },
  skills: { land: [23, 27], port: [22, 20], size: 60, depth: 0.6 },
  education: { land: [21, 68], port: [24, 61], size: 60, depth: 0.6 },
  certificates: { land: [42, 85], port: [46, 88], size: 46, depth: 0.3 },
  languages: { land: [7, 46], port: [12, 41], size: 36, depth: 0.2 },
  hobbies: { land: [91, 20], port: [88, 47], size: 36, depth: 0.2 },
};

// A real graph rather than a hub with spokes: each link joins two related
// sections and bows to one side by `bend` (fraction of its length).
const links: { from: string; to: string; bend: number; dashed?: boolean }[] = [
  { from: 'intro', to: 'experience', bend: 0.14 },
  { from: 'experience', to: 'projects', bend: -0.22 },
  { from: 'intro', to: 'skills', bend: -0.16 },
  { from: 'skills', to: 'projects', bend: -0.22 },
  { from: 'intro', to: 'education', bend: 0.16 },
  { from: 'education', to: 'certificates', bend: -0.2 },
  { from: 'education', to: 'languages', bend: 0.22 },
  { from: 'experience', to: 'hobbies', bend: -0.3, dashed: true },
];

const nodeStyle = (id: string, order: number) => {
  const { land, port, size, depth } = layout[id];
  // Front nodes land first, deep ones trail in behind them.
  const delay = Math.round(150 + (1 - depth) * 380 + order * 40);
  return `--lx: ${land[0]}%; --ly: ${land[1]}%; --px: ${port[0]}%; --py: ${port[1]}%; --size: ${size}; --node-delay: ${delay}ms;`;
};

const nodes = items.map((item, i) => ({ ...item, style: nodeStyle(item.id, i + 1) }));

// A few brighter stars that twinkle over the static star field (percent of the overlay).
const sparks = [
  [12, 14],
  [36, 7],
  [61, 11],
  [84, 34],
  [94, 72],
  [58, 93],
  [15, 87],
  [4, 28],
];
---

<div
  class="network-intro"
  id="network-intro"
  role="dialog"
  aria-modal="true"
  aria-label={labels.dialogLabel}
  tabindex="-1"
  hidden
>
  <div class="network-intro__bar">
    <p class="network-intro__prompt" aria-hidden="true">
      <span class="network-intro__prompt-cmd">$ ssh nam@portfolio</span>
      <span class="network-intro__prompt-hint">{labels.hint}</span>
    </p>
    <div class="network-intro__language">
      <LanguageSwitcher
        current={locale}
        label={labels.languageSwitcher}
        context="network"
      />
    </div>
  </div>

  {
    sparks.map(([x, y], i) => (
      <span
        class="network-intro__spark"
        aria-hidden="true"
        style={`left: ${x}%; top: ${y}%; --twinkle-delay: ${i * -0.7}s;`}
      />
    ))
  }

  <div class="network-intro__stage">
    <svg class="network-intro__lines" aria-hidden="true">
      {
        links.map((link, i) => (
          <path
            class:list={['network-intro__link', { 'network-intro__link--dashed': link.dashed }]}
            data-network-link
            data-from={link.from}
            data-to={link.to}
            data-bend={link.bend}
            style={`--line-delay: ${450 + i * 70}ms`}
          />
        ))
      }
    </svg>

    <button
      type="button"
      class="network-intro__center"
      data-network-node="intro"
      data-network-label={introLabel}
      data-depth={layout.intro.depth}
      style={nodeStyle('intro', 0)}
    >
      <span class="network-intro__center-ring" aria-hidden="true"></span>
      <img src={photoUrl} alt="" width="92" height="92" loading="eager" />
      <span class="network-intro__center-label">
        <strong>{name}</strong>
        <small>{role}</small>
      </span>
    </button>

    {
      nodes.map((node) => (
        <button
          type="button"
          class="network-intro__node"
          data-network-node={node.id}
          data-network-label={node.label}
          data-depth={layout[node.id].depth}
          data-tier={layout[node.id].size >= 76 ? 'major' : layout[node.id].size <= 46 ? 'minor' : undefined}
          style={node.style}
        >
          <span class="network-intro__node-circle" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={sectionIcons[node.id]}
            />
          </span>
          <span class="network-intro__node-label">{node.label}</span>
        </button>
      ))
    }
  </div>

  <div class="network-intro__actions">
    <button type="button" class="network-intro__assistant" data-network-assistant data-open-assistant>
      <span aria-hidden="true">$&nbsp;</span>{labels.assistant}
    </button>
    <button type="button" class="network-intro__skip" data-network-skip>
      <span aria-hidden="true">$&nbsp;</span>{labels.skip}
    </button>
  </div>
</div>

<dialog class="network-section-dialog" id="network-section-dialog" aria-label={labels.dialogLabel}>
  <div class="network-section-dialog__window">
    <div class="network-section-dialog__chrome">
      <span class="network-section-dialog__dot network-section-dialog__dot--red" aria-hidden="true"></span>
      <span class="network-section-dialog__dot network-section-dialog__dot--amber" aria-hidden="true"></span>
      <span class="network-section-dialog__dot network-section-dialog__dot--green" aria-hidden="true"></span>
      <span class="network-section-dialog__path" data-network-dialog-path></span>
      <div class="network-section-dialog__language">
        <LanguageSwitcher
          current={locale}
          label={labels.languageSwitcher}
          context="dialog"
        />
      </div>
      <button
        type="button"
        class="network-section-dialog__close"
        data-network-dialog-close
        aria-label={labels.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="network-section-dialog__body" data-network-dialog-body></div>
  </div>
</dialog>

<style>
  .network-intro {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Layered light, fine circuitry, and gold points echo the supplied banner. */
    background:
      radial-gradient(1.3px 1.3px at 22px 34px, color-mix(in srgb, var(--color-accent-gold) 70%, transparent) 60%, transparent) 0 0 / 240px 210px,
      radial-gradient(1px 1px at 96px 122px, color-mix(in srgb, var(--color-text-muted) 45%, transparent) 60%, transparent) 0 0 / 240px 210px,
      radial-gradient(1.5px 1.5px at 168px 58px, color-mix(in srgb, var(--color-accent-green) 55%, transparent) 60%, transparent) 0 0 / 340px 300px,
      repeating-linear-gradient(30deg, transparent 0 89px, rgb(145 188 157 / 4%) 90px, transparent 91px),
      repeating-linear-gradient(150deg, transparent 0 89px, rgb(145 188 157 / 4%) 90px, transparent 91px),
      radial-gradient(ellipse at 0% 0%, rgb(193 212 184 / 13%), transparent 52%),
      radial-gradient(ellipse at 48% 48%, rgb(51 110 78 / 23%), transparent 60%),
      radial-gradient(ellipse at 80% 90%, rgb(212 184 121 / 6%), transparent 45%),
      var(--color-bg);
    opacity: 1;
    transition: opacity 320ms ease;
  }

  .network-intro[hidden] {
    display: none;
  }

  /* The prompt and language switcher get their own row above the stage, so no
     node can run under them and a long hint wraps instead of overlapping. */
  .network-intro__bar {
    position: relative;
    z-index: 3; /* the language menu opens over the stage */
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) 0 var(--space-3);
  }

  .network-intro__language {
    flex: none;
  }

  .network-intro.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  /* Twinkle lives on a few 3px sparks rather than a full-screen layer, so it
     stays cheap even where compositing runs on the CPU. */
  .network-intro__spark {
    position: absolute;
    z-index: -1;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-text);
    box-shadow: 0 0 8px var(--color-accent-gold);
    opacity: 0.2;
    pointer-events: none;
    animation: network-twinkle 4s ease-in-out var(--twinkle-delay) infinite alternate;
  }

  @keyframes network-twinkle {
    to {
      opacity: 0.9;
    }
  }

  .network-intro__stage {
    position: relative;
    flex: 1;
    min-height: 0;
    /* Past this size the graph would only sprawl; keep it centred instead. */
    width: min(100%, 1600px);
    max-height: 1000px;
    margin: auto;
    /* Nodes pick their layout from the stage's own shape, not the viewport's. */
    container: network-stage / size;
    animation: network-zoom-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes network-zoom-in {
    from {
      transform: scale(1.14);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .network-intro__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .network-intro__link {
    fill: none;
    stroke: color-mix(in srgb, var(--color-accent-gold) 55%, var(--color-border));
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0.7;
    transition:
      opacity 180ms ease,
      stroke 180ms ease,
      stroke-width 180ms ease;
    animation: network-link-in 520ms ease-out var(--line-delay) backwards;
  }

  .network-intro__link--dashed {
    stroke-dasharray: 3 6;
  }

  @keyframes network-link-in {
    from {
      opacity: 0;
    }
  }

  .network-intro__stage[data-connection-active] .network-intro__link {
    opacity: 0.18;
  }

  .network-intro__stage[data-connection-active] .network-intro__link[data-active] {
    stroke: var(--color-accent-gold);
    stroke-width: 2;
    stroke-dasharray: 7 7;
    opacity: 1;
    animation: network-link-flow 900ms linear infinite;
  }

  @keyframes network-link-flow {
    to {
      stroke-dashoffset: -14;
    }
  }

  .network-intro__prompt {
    min-width: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 0.875rem;
  }

  .network-intro__prompt-cmd {
    color: var(--color-accent-gold);
  }

  .network-intro__prompt-hint {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  /* --- Nodes ------------------------------------------------------------ */

  .network-intro__node,
  .network-intro__center {
    /* Orb diameter: the node's weight (`--size`), scaled to the stage's short side. */
    --orb: clamp(calc(var(--size) * var(--orb-min) * 1px), calc(var(--size) * 0.139cqmin), calc(var(--size) * 1px));
    --orb-min: 0.7;
    position: absolute;
    left: var(--lx);
    top: var(--ly);
    /* (left, top) is the orb's centre, where links meet; the label hangs below. */
    transform: translate(-50%, calc(var(--orb) / -2));
    /* Size to the label, not to the room left of `left`, or labels near the
       right edge wrap early. */
    width: max-content;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    border: none;
    background: none;
    color: var(--color-text);
    font-family: inherit;
    cursor: pointer;
    transition: opacity 180ms ease;
  }

  @container network-stage (orientation: portrait) {
    .network-intro__node,
    .network-intro__center {
      left: var(--px);
      top: var(--py);
    }
  }

  .network-intro__node-circle,
  .network-intro__node-label,
  .network-intro__center img,
  .network-intro__center-label {
    animation: network-node-in 600ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--node-delay) backwards;
  }

  @keyframes network-node-in {
    from {
      opacity: 0;
      scale: 0.5;
    }
  }

  .network-intro__node-circle {
    display: grid;
    place-items: center;
    width: var(--orb);
    height: var(--orb);
    position: relative;
    isolation: isolate;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: linear-gradient(140deg, #294b38, #10271f 55%, #091c16);
    color: var(--color-text-muted);
    box-shadow: inset 0 1px 0 rgb(220 231 209 / 8%), 0 8px 24px rgb(0 0 0 / 20%);
    transition:
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .network-intro__node-circle::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid rgb(194 222 190 / 12%);
    border-radius: 8px;
    pointer-events: none;
  }

  .network-intro__node-circle::after {
    content: '';
    position: absolute;
    inset: auto -1px -6px;
    height: 12px;
    z-index: -1;
    border: 1px solid rgb(145 188 157 / 20%);
    border-top: 0;
    border-radius: 12px;
    background: linear-gradient(#183b2a, #081b14);
    pointer-events: none;
  }

  .network-intro__node[data-selected] .network-intro__node-circle {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
    box-shadow: 0 0 30px rgb(212 184 121 / 24%);
  }

  .network-intro__link[data-energized] {
    stroke: var(--color-accent-gold);
    filter: drop-shadow(0 0 3px rgb(212 184 121 / 45%));
  }

  .network-intro__node-circle svg {
    width: 36%;
    height: 36%;
  }

  .network-intro__node[data-tier='major'] .network-intro__node-circle {
    border-color: color-mix(in srgb, var(--color-accent-gold) 55%, transparent);
    background: radial-gradient(
      circle at 35% 30%,
      color-mix(in srgb, var(--color-accent-green) 16%, var(--color-surface)),
      var(--color-surface) 70%
    );
    color: var(--color-text);
  }

  .network-intro__node[data-tier='minor'] {
    opacity: 0.8;
  }

  .network-intro__node:hover .network-intro__node-circle,
  .network-intro__node:focus-visible .network-intro__node-circle,
  .network-intro__node[data-connected] .network-intro__node-circle {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent-gold) 12%, transparent), 0 0 28px rgb(145 188 157 / 15%);
    transform: scale(1.08);
  }

  .network-intro__node[data-near] .network-intro__node-circle {
    border-color: color-mix(in srgb, var(--color-accent-green) 60%, transparent);
  }

  .network-intro__stage[data-connection-active]
    :is(.network-intro__node, .network-intro__center):not([data-connected], [data-near]) {
    opacity: 0.45;
  }

  .network-intro__node-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    padding: 0 var(--space-1);
    border-radius: var(--radius);
    max-width: 130px;
    transition: color 160ms ease;
  }

  .network-intro__node[data-tier='major'] .network-intro__node-label,
  .network-intro__node:hover .network-intro__node-label,
  .network-intro__node:focus-visible .network-intro__node-label,
  .network-intro__node[data-connected] .network-intro__node-label {
    color: var(--color-text);
  }

  /* --- Center node -------------------------------------------------------- */

  .network-intro__center img {
    width: var(--orb);
    height: var(--orb);
    border-radius: 50%;
    border: 2px solid var(--color-accent-gold);
    object-fit: cover;
    object-position: 50% 24%;
    transition: box-shadow 160ms ease, transform 160ms ease;
  }

  .network-intro__center-ring {
    position: absolute;
    top: calc(var(--orb) / 2); /* centred on the photo */
    left: 50%;
    width: calc(var(--orb) * 1.18);
    height: calc(var(--orb) * 1.18);
    transform: translate(-50%, -50%);
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 45%, transparent);
    border-radius: 50%;
    animation: network-pulse 2.6s ease-out infinite;
    pointer-events: none;
  }

  @keyframes network-pulse {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: translate(-50%, -50%) scale(1.45);
      opacity: 0;
    }
  }

  .network-intro__center:hover img,
  .network-intro__center:focus-visible img,
  .network-intro__center[data-connected] img,
  .network-intro__center[data-near] img {
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-accent-green) 45%, transparent);
    transform: scale(1.04);
  }

  .network-intro__center-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    border-radius: var(--radius);
    padding: 0 var(--space-2);
  }

  .network-intro__center-label strong {
    font-size: 0.9375rem;
  }

  .network-intro__center-label small {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  /* --- Skip -------------------------------------------------------------- */

  .network-intro__actions {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    max-width: calc(100vw - var(--space-5));
    margin: 0 0 calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
  }

  .network-intro__assistant,
  .network-intro__skip {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: 0.875rem;
    text-align: center;
    cursor: pointer;
    animation: network-skip-in 500ms ease 900ms both;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .network-intro__assistant {
    border-color: color-mix(in srgb, var(--color-accent-gold) 55%, var(--color-border));
    color: var(--color-accent-gold);
  }

  @keyframes network-skip-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .network-intro__assistant:hover,
  .network-intro__assistant:focus-visible,
  .network-intro__skip:hover,
  .network-intro__skip:focus-visible {
    color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
  }

  @media (max-width: 640px) {
    .network-intro__node-label {
      font-size: 0.75rem;
      max-width: 96px;
      line-height: 1.3;
    }

    .network-intro__prompt {
      font-size: 0.8125rem;
    }
  }

  /* Landscape phones: smaller buttons side by side leave the graph more height. */
  @media (max-height: 500px) {
    .network-intro__actions {
      flex-flow: row wrap;
      justify-content: center;
      margin-bottom: calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
    }

    .network-intro__assistant,
    .network-intro__skip {
      padding: var(--space-1) var(--space-2);
      font-size: 0.75rem;
    }
  }

  /* Short stages (landscape phones, the smallest portrait ones): orbs and labels
     shrink further so the graph still fits between the prompt and the buttons. */
  @container network-stage (max-height: 420px) {
    .network-intro__node,
    .network-intro__center {
      --orb-min: 0.5;
    }

    .network-intro__node-label {
      font-size: 0.75rem;
      line-height: 1.3;
    }

    .network-intro__center-label strong {
      font-size: 0.8125rem;
    }

    .network-intro__center-label small {
      font-size: 0.6875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .network-intro__spark,
    .network-intro__stage,
    .network-intro__link,
    .network-intro__node-circle,
    .network-intro__node-label,
    .network-intro__center img,
    .network-intro__center-label,
    .network-intro__center-ring,
    .network-intro__assistant,
    .network-intro__skip {
      animation: none;
    }

    .network-intro__stage[data-connection-active] .network-intro__link[data-active] {
      stroke-dasharray: none;
      animation: none;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .network-intro__center-ring,
    .network-intro__stage[data-connection-active] .network-intro__link[data-active] {
      animation: none;
    }
  }
</style>

<style>
  .network-section-dialog {
    width: min(760px, calc(100vw - 2rem));
    max-width: none;
    max-height: min(78dvh, 760px);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    overflow: hidden;
    box-shadow:
      0 24px 80px rgb(0 0 0 / 65%),
      0 0 32px color-mix(in srgb, var(--color-accent-green) 14%, transparent);
  }

  .network-section-dialog::backdrop {
    background: rgb(4 15 11 / 68%);
    backdrop-filter: blur(3px);
  }

  .network-section-dialog__window {
    display: flex;
    flex-direction: column;
    max-height: min(78dvh, 760px);
  }

  .network-section-dialog__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 46px;
    padding: var(--space-2) var(--space-3);
    background: var(--surface-sheen);
    border-bottom: 1px solid var(--color-border);
  }

  .network-section-dialog__dot {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .network-section-dialog__dot--red {
    background: var(--color-accent-red);
  }

  .network-section-dialog__dot--amber {
    background: var(--color-accent-amber);
  }

  .network-section-dialog__dot--green {
    background: var(--color-accent-green);
  }

  .network-section-dialog__path {
    min-width: 0;
    flex: 1;
    margin-left: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .network-section-dialog__language {
    flex: 0 0 auto;
  }

  .network-section-dialog__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .network-section-dialog__close:hover,
  .network-section-dialog__close:focus-visible {
    color: var(--color-text);
    border-color: var(--color-accent-red);
    background: color-mix(in srgb, var(--color-accent-red) 10%, transparent);
  }

  .network-section-dialog__body {
    min-height: 0;
    padding: var(--space-4);
    overflow: auto;
    overscroll-behavior: contain;
  }

  :global(.is-network-dialog-section) {
    margin: 0;
    outline: none;
  }

  @media (max-width: 640px) {
    .network-section-dialog {
      width: calc(100vw - 1rem);
      max-height: 84dvh;
    }

    .network-section-dialog__window {
      max-height: 84dvh;
    }

    .network-section-dialog__body {
      padding: var(--space-3);
    }

    .network-section-dialog__path {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 420px) {
    .network-section-dialog__path {
      display: none;
    }
  }
</style>

<script>
  import { activateNetworkNode, revealWindowContent } from '../scripts/interface-effects';

  const SEEN_KEY = 'network-intro-seen';
  const PENDING_NETWORK_KEY = 'network-intro-pending';
  const PENDING_SECTION_KEY = 'network-intro-pending-section';
  const overlay = document.getElementById('network-intro');
  const sectionDialog = document.querySelector<HTMLDialogElement>('#network-section-dialog');
  const sectionDialogBody = sectionDialog?.querySelector<HTMLElement>('[data-network-dialog-body]');
  const sectionDialogPath = sectionDialog?.querySelector<HTMLElement>('[data-network-dialog-path]');

  let activeSection: HTMLElement | null = null;
  let activeSectionAnchor: Comment | null = null;
  let activeSectionTabindex: string | null = null;
  let sourceNode: HTMLElement | null = null;
  let dialogAnimation: Animation | null = null;
  let dialogClosing = false;
  let contentAnimations: Animation[] = [];

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const restoreSection = () => {
    const focusTarget = sourceNode;
    contentAnimations.forEach(animation => animation.cancel());
    contentAnimations = [];
    sourceNode?.removeAttribute('data-selected');
    overlay?.querySelectorAll('[data-energized]').forEach(link => link.removeAttribute('data-energized'));

    if (activeSection && activeSectionAnchor?.parentNode) {
      activeSectionAnchor.parentNode.insertBefore(activeSection, activeSectionAnchor);
      activeSectionAnchor.remove();
      activeSection.classList.remove('is-network-dialog-section');
      if (activeSectionTabindex === null) {
        activeSection.removeAttribute('tabindex');
      } else {
        activeSection.setAttribute('tabindex', activeSectionTabindex);
      }
    }

    activeSection = null;
    activeSectionAnchor = null;
    activeSectionTabindex = null;
    sourceNode = null;
    sectionDialog?.removeAttribute('aria-labelledby');
    if (sectionDialogPath) sectionDialogPath.textContent = '';
    if (sectionDialogBody) sectionDialogBody.scrollTop = 0;
    dialogClosing = false;

    focusTarget?.focus({ preventScroll: true });
  };

  const runDialogAnimation = async (opening: boolean) => {
    if (!sectionDialog || !sourceNode || prefersReducedMotion.matches) return;

    const sourceRect = sourceNode.getBoundingClientRect();
    const dialogRect = sectionDialog.getBoundingClientRect();
    const offsetX = sourceRect.left + sourceRect.width / 2 - (dialogRect.left + dialogRect.width / 2);
    const offsetY = sourceRect.top + sourceRect.height / 2 - (dialogRect.top + dialogRect.height / 2);
    const atNode = {
      opacity: 0,
      transform: `translate(${offsetX}px, ${offsetY}px) scale(0.18)`,
    };
    const atCenter = { opacity: 1, transform: 'translate(0, 0) scale(1)' };
    const settle = { opacity: 1, transform: 'translate(0, 0) scale(1.015)', offset: .78 };

    dialogAnimation?.cancel();
    const animation = sectionDialog.animate(opening ? [atNode, settle, atCenter] : [atCenter, atNode], {
      duration: opening ? 360 : 210,
      easing: opening ? 'cubic-bezier(0.16, 1, 0.3, 1)' : 'ease-in',
      fill: 'both',
    });
    dialogAnimation = animation;

    try {
      await animation.finished;
    } catch {
      // A new open/close action superseded this animation.
    } finally {
      if (dialogAnimation === animation) {
        animation.cancel();
        dialogAnimation = null;
      }
    }
  };

  const closeSectionDialog = async () => {
    if (!sectionDialog?.open || dialogClosing) return;
    dialogClosing = true;
    await runDialogAnimation(false);
    sectionDialog.close();
  };

  const openSectionDialog = (targetId: string, node: HTMLElement) => {
    if (!sectionDialog || !sectionDialogBody || sectionDialog.open) return;

    const target = document.getElementById(targetId);
    if (!(target instanceof HTMLElement) || target.tagName !== 'SECTION' || !target.parentNode) return;

    activeSection = target;
    activeSectionAnchor = document.createComment(`network-section:${targetId}`);
    activeSectionTabindex = target.getAttribute('tabindex');
    sourceNode = node;
    node.setAttribute('data-selected', '');
    activateNetworkNode(node);
    overlay?.querySelectorAll<SVGPathElement>('[data-network-link]').forEach(link => {
      const connected = link.dataset.from === targetId || link.dataset.to === targetId;
      link.toggleAttribute('data-energized', connected);
    });
    target.parentNode.insertBefore(activeSectionAnchor, target);
    target.classList.add('is-network-dialog-section');
    target.setAttribute('tabindex', '-1');
    sectionDialogBody.append(target);

    const headingId = target.getAttribute('aria-labelledby');
    if (headingId) sectionDialog.setAttribute('aria-labelledby', headingId);
    const localizedLabel = node.dataset.networkLabel ?? targetId;
    if (sectionDialogPath) sectionDialogPath.textContent = `$ view --section // ${localizedLabel}`;

    sectionDialog.showModal();
    void runDialogAnimation(true);
    contentAnimations = revealWindowContent(target);
    target.focus({ preventScroll: true });
  };

  sectionDialog?.addEventListener('close', restoreSection);
  sectionDialog?.addEventListener('cancel', (event) => {
    const openSwitcher = sectionDialog.querySelector<HTMLDetailsElement>('[data-language-switcher][open]');
    if (openSwitcher) {
      event.preventDefault();
      openSwitcher.open = false;
      return;
    }
    event.preventDefault();
    void closeSectionDialog();
  });
  sectionDialog?.addEventListener(
    'keydown',
    (event) => {
      const openSwitcher = sectionDialog.querySelector<HTMLDetailsElement>('[data-language-switcher][open]');
      if (event.key === 'Escape' && openSwitcher) {
        event.preventDefault();
        event.stopPropagation();
        openSwitcher.open = false;
      }
    },
    true,
  );
  sectionDialog?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-network-dialog-close]')) {
      void closeSectionDialog();
      return;
    }

    if (event.target !== sectionDialog) return;
    const rect = sectionDialog.getBoundingClientRect();
    const outside =
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom;
    if (outside) void closeSectionDialog();
  });

  if (overlay) {
    const networkStage = overlay.querySelector<HTMLElement>('.network-intro__stage');
    const linesSvg = overlay.querySelector<SVGSVGElement>('.network-intro__lines');
    // Nodes drift with the pointer. (x, y) is a node's orb centre in stage px
    // at rest; (dx, dy) its parallax offset.
    const layers = Array.from(overlay.querySelectorAll<HTMLElement>('[data-depth]')).map((el) => ({
      el,
      depth: Number(el.dataset.depth),
      x: 0,
      y: 0,
      dx: 0,
      dy: 0,
    }));
    const graphNodes = new Map(
      layers.filter(({ el }) => el.dataset.networkNode).map((node) => [node.el.dataset.networkNode!, node]),
    );
    const graphLinks = Array.from(overlay.querySelectorAll<SVGPathElement>('[data-network-link]')).map((el) => ({
      el,
      from: el.dataset.from ?? '',
      to: el.dataset.to ?? '',
      bend: Number(el.dataset.bend),
    }));
    let connectedNode: HTMLElement | null = null;

    const drawLinks = () => {
      graphLinks.forEach(({ el, from, to, bend }) => {
        const a = graphNodes.get(from);
        const b = graphNodes.get(to);
        if (!a || !b) return;
        const x0 = a.x + a.dx;
        const y0 = a.y + a.dy;
        const x2 = b.x + b.dx;
        const y2 = b.y + b.dy;
        // Control point pushed off the midpoint, perpendicular to the link.
        const cx = (x0 + x2) / 2 - (y2 - y0) * bend;
        const cy = (y0 + y2) / 2 + (x2 - x0) * bend;
        const r = (value: number) => value.toFixed(1);
        el.setAttribute('d', `M${r(x0)} ${r(y0)} Q${r(cx)} ${r(cy)} ${r(x2)} ${r(y2)}`);
      });
    };

    // CSS owns the layout (including the portrait switch); links are drawn from
    // where it put each node. offsetLeft/Top ignore transforms, so the stage's
    // zoom-in and the parallax translate never skew the measurement.
    if (networkStage && linesSvg) {
      new ResizeObserver(() => {
        linesSvg.setAttribute('viewBox', `0 0 ${networkStage.clientWidth} ${networkStage.clientHeight}`);
        graphNodes.forEach((node) => {
          node.x = node.el.offsetLeft;
          node.y = node.el.offsetTop;
        });
        drawLinks();
      }).observe(networkStage);
    }

    // Pointer parallax: layers drift against the mouse in proportion to their
    // depth. The frame loop runs only while the scene is catching up with the
    // pointer, then stops, so an idle map costs nothing.
    const parallaxAllowed = window.matchMedia(
      '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
    );
    const PARALLAX_SHIFT = 30;
    const pointerTarget = { x: 0, y: 0 };
    const pointerCurrent = { x: 0, y: 0 };
    let parallaxFrame = 0;
    let lastFrameTime = 0;

    const stepParallax = (time: number) => {
      // Close ~10% of the gap per 60 Hz frame, at whatever rate frames arrive.
      const ease = lastFrameTime ? 1 - 0.9 ** ((time - lastFrameTime) / 16.7) : 0.1;
      pointerCurrent.x += (pointerTarget.x - pointerCurrent.x) * ease;
      pointerCurrent.y += (pointerTarget.y - pointerCurrent.y) * ease;
      const settled =
        Math.abs(pointerTarget.x - pointerCurrent.x) + Math.abs(pointerTarget.y - pointerCurrent.y) < 0.002;
      lastFrameTime = settled ? 0 : time;
      layers.forEach((layer) => {
        layer.dx = -pointerCurrent.x * PARALLAX_SHIFT * layer.depth;
        layer.dy = -pointerCurrent.y * PARALLAX_SHIFT * layer.depth;
        layer.el.style.translate = `${layer.dx.toFixed(1)}px ${layer.dy.toFixed(1)}px`;
      });
      drawLinks();
      parallaxFrame = settled ? 0 : requestAnimationFrame(stepParallax);
    };

    const moveParallax = (x: number, y: number) => {
      pointerTarget.x = x;
      pointerTarget.y = y;
      if (!parallaxFrame) parallaxFrame = requestAnimationFrame(stepParallax);
    };

    overlay.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || !parallaxAllowed.matches) return;
      moveParallax(event.clientX / window.innerWidth - 0.5, event.clientY / window.innerHeight - 0.5);
    });
    overlay.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') moveParallax(0, 0);
    });

    const setConnectedNode = (node: HTMLElement | null) => {
      if (connectedNode === node) return;
      connectedNode = node;
      const activeId = node?.dataset.networkNode;
      // Light up every link touching the node, and the nodes at their far ends.
      const nearIds = new Set<string>();
      graphLinks.forEach(({ el, from, to }) => {
        const active = Boolean(activeId) && (from === activeId || to === activeId);
        el.toggleAttribute('data-active', active);
        if (active) nearIds.add(from === activeId ? to : from);
      });
      networkStage?.toggleAttribute('data-connection-active', Boolean(activeId));
      graphNodes.forEach(({ el }, id) => {
        el.toggleAttribute('data-connected', el === node && Boolean(activeId));
        el.toggleAttribute('data-near', nearIds.has(id));
      });
    };

    const findConnectionNode = (target: EventTarget | null) =>
      target instanceof Element
        ? target.closest<HTMLElement>('.network-intro__stage [data-network-node]')
        : null;

    overlay.addEventListener('pointerover', (event) => {
      const node = findConnectionNode(event.target);
      if (node) setConnectedNode(node);
    });

    overlay.addEventListener('pointerout', (event) => {
      const node = findConnectionNode(event.target);
      if (!node || node !== connectedNode) return;
      if (event.relatedTarget instanceof Element && node.contains(event.relatedTarget)) return;
      setConnectedNode(null);
    });

    overlay.addEventListener('focusin', (event) => {
      const node = findConnectionNode(event.target);
      if (node) setConnectedNode(node);
    });

    overlay.addEventListener('focusout', (event) => {
      const node = findConnectionNode(event.target);
      if (!node || node !== connectedNode) return;
      if (event.relatedTarget instanceof Element && node.contains(event.relatedTarget)) return;
      setConnectedNode(null);
    });

    overlay.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      const node = findConnectionNode(event.target);
      if (node) setConnectedNode(node);
    });

    const clearTouchConnection = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') setConnectedNode(null);
    };

    overlay.addEventListener('pointerup', clearTouchConnection);
    overlay.addEventListener('pointercancel', clearTouchConnection);

    const openOverlay = () => {
      if (sectionDialog?.open) sectionDialog.close();
      setConnectedNode(null);
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      overlay.focus({ preventScroll: true });
    };

    const closeOverlay = () => {
      setConnectedNode(null);
      try {
        sessionStorage.setItem(SEEN_KEY, '1');
      } catch {
        // Storage may be unavailable (private mode); the intro just replays.
      }
      overlay.classList.add('is-leaving');
      window.setTimeout(() => {
        overlay.hidden = true;
        overlay.classList.remove('is-leaving');
        document.body.style.overflow = '';
        document.dispatchEvent(new CustomEvent('network-intro:closed'));
      }, 320);
    };

    overlay.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      const node = el.closest<HTMLElement>('[data-network-node]');
      if (node?.dataset.networkNode) {
        openSectionDialog(node.dataset.networkNode, node);
        return;
      }
      if (el.closest('[data-network-assistant]')) {
        // Deliberately does not call closeOverlay(): the assistant dialog
        // opens as a sibling top-layer dialog, and the overlay should stay
        // exactly as the visitor left it once the dialog is closed.
        return;
      }
      if (el.closest('[data-network-skip]')) {
        closeOverlay();
      }
    });

    overlay.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const openSwitcher = overlay.querySelector<HTMLDetailsElement>('[data-language-switcher][open]');
        if (openSwitcher) {
          event.preventDefault();
          openSwitcher.open = false;
          return;
        }
        closeOverlay();
        return;
      }
      // Minimal focus trap: keep Tab cycling inside the full-screen dialog.
      if (event.key === 'Tab') {
        const focusables = Array.from(
          overlay.querySelectorAll<HTMLElement>('button, summary, a[href]'),
        ).filter((element) => element.getClientRects().length > 0);
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // Re-open from anywhere (e.g. the nav rail's map button).
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const networkLanguageLink = target.closest<HTMLAnchorElement>(
        '[data-language-context="network"] [data-language-target], [data-language-context="dialog"] [data-language-target]',
      );
      if (networkLanguageLink) {
        try {
          sessionStorage.setItem(PENDING_NETWORK_KEY, '1');
          sessionStorage.removeItem(SEEN_KEY);
          if (activeSection?.id) {
            sessionStorage.setItem(PENDING_SECTION_KEY, activeSection.id);
          } else {
            sessionStorage.removeItem(PENDING_SECTION_KEY);
          }
        } catch {
          // Navigation still works if storage is unavailable; only context is lost.
        }
      }

      if (target.closest('[data-open-network]')) {
        openOverlay();
      }
    });

    let seen = false;
    let pendingNetwork = false;
    let pendingSection: string | null = null;
    try {
      seen = sessionStorage.getItem(SEEN_KEY) === '1';
      pendingNetwork = sessionStorage.getItem(PENDING_NETWORK_KEY) === '1';
      pendingSection = sessionStorage.getItem(PENDING_SECTION_KEY);
      sessionStorage.removeItem(PENDING_NETWORK_KEY);
      sessionStorage.removeItem(PENDING_SECTION_KEY);
    } catch {
      seen = false;
    }
    if (!seen || pendingNetwork) {
      openOverlay();
      if (pendingSection) {
        const pendingNode = Array.from(
          overlay.querySelectorAll<HTMLElement>('[data-network-node]'),
        ).find((node) => node.dataset.networkNode === pendingSection);
        if (pendingNode) openSectionDialog(pendingSection, pendingNode);
      }
    }
  }
</script>
